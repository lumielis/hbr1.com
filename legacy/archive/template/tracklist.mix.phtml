function TextLight( text, color, light ) {
  var c_max = new Color( light );
  var c_inp = new Color( color );
  var c_out = new Color( color );
  var size = text.length + 1;
  var out = '';
  for( var i = 1; i < size; i ++ ) {
    var angle = Math.sin( ( 180 / size * i ) * Math.PI / 180 );
    c_out.R = parseInt( c_inp.R + ( c_max.R - c_inp.R ) * angle );
    c_out.G = parseInt( c_inp.G + ( c_max.G - c_inp.G ) * angle );
    c_out.B = parseInt( c_inp.B + ( c_max.B - c_inp.B ) * angle );
    out += '<font color="#' + c_out.AsString() + '">' + text.substr( i - 1, 1 ) + '</font>';
  }
  return out;
}

function TextFade( text, col_from, col_to ) {
  var c_max = new Color( col_to );
  var c_inp = new Color( col_from );
  var c_out = new Color( col_from );
  var size = text.length + 1;
  var out = '';
  for( var i = 1; i < size; i ++ ) {
    c_out.R = parseInt( c_inp.R + ( c_max.R - c_inp.R ) / size * i );
    c_out.G = parseInt( c_inp.G + ( c_max.G - c_inp.G ) / size * i );
    c_out.B = parseInt( c_inp.B + ( c_max.B - c_inp.B ) / size * i );
    out += '<font color="#' + c_out.AsString() + '">' + text.substr( i - 1, 1 ) + '</font>';
  }
  return out;
}

