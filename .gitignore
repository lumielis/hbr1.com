.idea/
.vscode/
temp/

# Composer
/vendor/
composer.phar
/auth.json

# Runtime state
/var/
*.log
.phpunit.result.cache
.phpunit.cache/

# Local secrets (never commit) - see env.php
/env.local.php

# Perl library sources, used only to build the throwaway 5.10 oracle
/docker/legacy-perl/perl-lib/PAB/
/docker/legacy-perl/perl-lib/PAB2/
/docker/legacy-perl/perl-lib/PAB3/
/docker/legacy-perl/perl-lib/pab3/
/docker/legacy-perl/perl-lib/ssms/
/docker/legacy-perl/build/

# The admin gate - crypt hashes are credentials. Install from the password
# manager; see deploy/apache/www.hbr1.com.conf for the location. The archived
# copy under legacy/archive/ must stay ignored too, or a `git add -A` after the
# cleanup would pick it up again.
/htdocs/admin/.htpasswd
/legacy/archive/**/.htpasswd
/public/**/.htpasswd

# Legacy config backups - they hold credentials by definition.
cgi-bin/include/*.old
legacy/archive/cgi-bin/include/*.old
